{
	"name": "t2m",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"docker:up": "docker compose up",
		"db:start": "docker compose up",
		"db:recreate": "docker compose down -v && docker compose up -d db && until docker compose exec -T db pg_isready -U root -d local >/dev/null 2>&1; do sleep 1; done && npx drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file=.env src/lib/server/db/seed/seed.ts",
		"db:clear": "tsx --env-file=.env src/lib/server/db/seed/reset.ts",
		"auth:schema": "npx auth@latest generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"eval:correction": "promptfoo eval -c promptfoo/message-correction/promptfooconfig.yaml --env-file .env --delay 1024",
		"eval:chat-reply": "promptfoo eval -c promptfoo/chat-reply/promptfooconfig.yaml --env-file .env --delay 1024",
		"eval:feedback": "promptfoo eval -c promptfoo/translation-feedback/promptfooconfig.yaml --env-file .env --delay 1024",
		"eval:patterns": "promptfoo eval -c promptfoo/error-patterns/promptfooconfig.yaml --env-file .env --delay 1024",
		"eval:view": "promptfoo view"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/ndjson": "^2.0.4",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.0",
		"auth": "^1.7.2",
		"better-auth": "^1.7.2",
		"dedent": "^1.7.2",
		"diff": "^9.0.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-seed": "^0.3.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"melt": "^0.44.0",
		"playwright": "^1.62.1",
		"postgres": "^3.4.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.1.18",
		"ts-fsrs": "^5.4.1",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.2.1",
		"zod": "^4.4.3",
		"promptfoo": "^0.122.2",
		"openai": "^7.8.0"
	},
	"dependencies": {}
}
